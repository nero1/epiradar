# ============================================================
# EpiRadar Environment Variables
# Copy this file to .env.local for local development.
# NEVER commit .env.local to git.
# All variables marked NEXT_PUBLIC_ are exposed to the browser.
# ============================================================

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here  # NEVER expose this to the client

# ---- Redis (select provider via REDIS_PROVIDER) ----
REDIS_PROVIDER=upstash          # "upstash" or "self-hosted"
UPSTASH_REDIS_URL=rediss://default:your-token@your-endpoint.upstash.io:6379
# Self-hosted alternative (used when REDIS_PROVIDER=self-hosted):
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- AI Providers ----
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# ---- Email (select provider via EMAIL_PROVIDER) ----
EMAIL_PROVIDER=resend           # "resend" or "postmark"
RESEND_API_KEY=re_your-resend-key-here
POSTMARK_SERVER_TOKEN=your-postmark-token-here
EMAIL_FROM=alerts@epiradar.io

# ---- Payments ----
PAYSTACK_SECRET_KEY=sk_live_your-paystack-key-here
PAYSTACK_PUBLIC_KEY=pk_live_your-paystack-key-here
PAYSTACK_WEBHOOK_SECRET=your-paystack-webhook-secret-here
DODOPAYMENTS_API_KEY=your-dodopayments-key-here
DODOPAYMENTS_WEBHOOK_SECRET=your-dodopayments-webhook-secret-here

# ---- CRON Security ----
# Generate with: openssl rand -hex 32
CRON_SECRET=your-random-secret-for-cron-endpoint-here

# ---- App ----
NEXT_PUBLIC_APP_URL=https://epiradar.io
NODE_ENV=development

# ---- Cloudflare Turnstile (bot protection) ----
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-site-key-here
TURNSTILE_SECRET_KEY=your-secret-key-here

# ---- i18n ----
NEXT_PUBLIC_DEFAULT_LOCALE=en
