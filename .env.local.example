# EpiRadar Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.

# ============================================================
# Supabase (required)
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================================
# App URL
# ============================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================
# AI providers (required for ingestion)
# ============================================================
DEEPSEEK_API_KEY=sk-...
GEMINI_API_KEY=AIza...

# ============================================================
# Redis / caching (optional — skipped if not set)
# ============================================================
REDIS_PROVIDER=upstash
UPSTASH_REDIS_URL=https://your-redis.upstash.io
UPSTASH_REDIS_TOKEN=your-token

# ============================================================
# Email — Mailgun (required for paid-user alert digests)
# Emails are only sent to paid users. Free accounts receive no email.
# ============================================================
MAILGUN_API_KEY=key-...
MAILGUN_DOMAIN=mg.epiradar.io
EMAIL_FROM=EpiRadar Alerts <alerts@epiradar.io>

# ============================================================
# Payments (optional — required for paid plan)
# ============================================================
PAYSTACK_SECRET_KEY=sk_live_...
DODOPAYMENTS_API_KEY=dodo_...
DODOPAYMENTS_WEBHOOK_SECRET=whsec_...

# ============================================================
# Bot protection (optional — widget hidden if not set)
# ============================================================
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...
TURNSTILE_SECRET_KEY=0x4AAAAAAA...

# ============================================================
# CRON security (required for CRON endpoints)
# ============================================================
CRON_SECRET=generate-a-long-random-secret-here
